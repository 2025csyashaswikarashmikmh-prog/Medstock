# Copy this file to ".env" (same folder) and fill in. Never share or upload the real .env file.

# ---- Daily e-mail alerts (free with a Gmail account + "App password") ----
# Gmail: Google Account -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourshop@gmail.com
SMTP_PASS=your-16-letter-app-password
ALERT_TO=owner@example.com
ALERT_HOUR=9

# ---- Optional: read supplier-bill photos with Claude (costs a few paise per bill) ----
# ANTHROPIC_API_KEY=sk-ant-...
